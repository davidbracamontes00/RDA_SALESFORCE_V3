# Copia este archivo como .env. Cambia el usuario y la contraseña antes de iniciar.
RDA_USERNAME=operador
RDA_PASSWORD=CAMBIA-ESTA-CONTRASENA-POR-UNA-LARGA-Y-UNICA

# El proxy solo escucha en la máquina local por defecto.
RDA_BIND_ADDRESS=127.0.0.1
RDA_HTTP_PORT=8080
RDA_ALLOWED_HOSTS=localhost,127.0.0.1
RDA_MAX_FILE_MB=25
RDA_MAX_EXPANDED_MB=128
RDA_REPORT_RETENTION_DAYS=90
